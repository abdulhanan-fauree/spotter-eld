DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-api.vercel.app

# Required once the frontend is on a different origin.
CORS_ALLOWED_ORIGINS=https://your-web.vercel.app

# Postgres. Vercel injects this automatically when a database integration is
# attached to the project — set it by hand only to test against Postgres locally.
# Left unset, the app uses SQLite, which is the intended dev default.
DATABASE_URL=

# Optional: switches routing from a car (OSRM) to a truck (ORS driving-hgv).
ORS_API_KEY=
